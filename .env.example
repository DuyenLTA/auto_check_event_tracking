# Tool khong can token nao. File nay chi de khai ADB_PATH khi adb khong nam
# trong PATH - va start.sh cung tu do tim trong ~/Android/Sdk/platform-tools
# nen thuong khong phai dien gi ca.
#
# Luu y: start.sh KHONG doc file .env. Muon dung thi export truoc khi chay:
#   export ADB_PATH=/duong/dan/toi/adb
ADB_PATH=
