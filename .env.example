# Tool khong can token de CHAM. File nay chi de khai cac bien tuy chon.
#
# Luu y: start.sh KHONG doc file .env. Muon dung thi export truoc khi chay,
# hoac dat han trong ~/.bashrc.

# adb khong nam trong PATH thi chi duong dan o day.
# start.sh cung tu tim trong ~/Android/Sdk/platform-tools nen thuong khong
# phai dien gi ca.
ADB_PATH=

# Chi can khi nap spec bang LINK CONFLUENCE. Dan bang tay thi bo trong.
# Token la personal access token cua chinh ban - KHONG commit vao git.
CONFLUENCE_BASE_URL=
CONFLUENCE_TOKEN=
